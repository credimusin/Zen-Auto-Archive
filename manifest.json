{
  "manifest_version": 3,
  "name": "Zen Auto Archive",
  "version": "1.1.1",
  "description": "Automatically archives inactive unpinned tabs, bringing Arc's auto-archive experience to Zen Browser.",
  "homepage_url": "https://github.com/credimusin/Zen-Auto-Archive",
  "browser_specific_settings": {
    "gecko": {
      "id": "zen-auto-archive@credimusin.github.io",
      "strict_min_version": "140.0",
      "data_collection_permissions": {
        "required": ["none"]
      }
    }
  },
  "background": {
    "scripts": ["defaults.js", "background.js"]
  },
  "permissions": ["tabs", "storage", "alarms"],
  "action": {
    "default_popup": "popup/popup.html",
    "default_icon": "icons/icon.svg",
    "default_title": "Zen Auto Archive"
  },
  "options_ui": {
    "page": "options/options.html",
    "open_in_tab": true
  },
  "icons": {
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "64": "icons/icon-64.png",
    "96": "icons/icon-96.png",
    "128": "icons/icon-128.png"
  }
}
